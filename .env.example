# ============================================================
# Setad Jang — Environment Variables Example
# ============================================================
# این فایل صرفاً یک reference است و نباید مقادیر واقعی production
# داخل آن قرار بگیرد. برای محیط local یک کپی به اسم `.env` بساز
# و مقادیر را آنجا تنظیم کن. خود `.env` در .gitignore است.
#
# قرارداد:
# - مقادیر داخل این فایل نمونه/توضیحی هستند، نه واقعی
# - برای production باید SECRET_KEY، ALLOWED_HOSTS و سایر مقادیر
#   حساس را در یک secret manager یا env واقعی سرور تنظیم کنی
#
# ── 12-Factor App ──
# هر تنظیم environment-specific باید فقط از طریق این متغیرها
# قابل تغییر باشد، نه از طریق ویرایش کد.

# ============================================================
# Django core
# ============================================================
# نام ماژول settings برای Django.
# - development: config.settings.development
# - production : config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# کلید محرمانه‌ی Django.
# در production هرگز از مقدار پیش‌فرض استفاده نکن.
# می‌توانی با این دستور یک کلید قوی بسازی (حداقل 50 کاراکتر):
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=change-me-in-production

# حالت دیباگ. در production حتماً False باشد.
DEBUG=True

# لیست hostهای مجاز، جداشده با کاما.
# در production باید دامنه‌های واقعی پروژه را بنویسی.
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Django core (ادامه) ──
# کوکی‌های امنیتی — در production هر سه باید True باشند.
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# سقف‌های upload (برحسب بایت / تعداد فیلد-فایل).
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
# حداکثر حجم فایل upload شده (برحسب بایت) — در مسیر read/write هم اعمال می‌شود.
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
DATA_UPLOAD_MAX_NUMBER_FIELDS=500
DATA_UPLOAD_MAX_NUMBER_FILES=10

# WhiteNoise — فقط برای توسعه/استاتیک‌سروینگ راحت‌تر.
WHITENOISE_AUTOREFRESH=True
WHITENOISE_USE_FINDERS=True

# ── Client IP / proxy ──
# تعداد پراکسی‌های «قابل اعتماد» پشت سرویس (یافتهٔ P1 ممیزی):
# پیش‌فرض صفر است و در این حالت header ورودی X-Forwarded-For هرگز معتبر نیست
# (REMOTE_ADDR تنها منبع IP است). اگر دقیقاً پشت n پراکسی هستید که XFF را
# بازنویسی می‌کنند، آن را n بگذارید — نه تعداد hops شبکه.
NUM_PROXIES=0

# سرو مستقیم media در صورت نبود CDN/فایل‌استوریج جدا (production معمولاً False).
SERVE_PUBLIC_MEDIA=False

# ============================================================
# Database
# ============================================================
# Development default در base.py همچنان SQLite است؛ production.py به‌صورت
# پیش‌فرض PostgreSQL می‌خواهد. برای production واقعی از PostgreSQL استفاده کن.
DATABASE_ENGINE=sqlite
DATABASE_PATH=

# نام دیتابیس TEST (پیش‌فرض: <POSTGRES_DB>_test).
POSTGRES_TEST_DB=setadjang_test

# PostgreSQL — برای config.settings.production و docker-compose.
# یک password قوی بساز و هرگز مقدار واقعی production را commit نکن.
POSTGRES_DB=setadjang
POSTGRES_USER=setadjang
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10

# فقط برای demo/emergency local؛ production واقعی نباید SQLite باشد.
ALLOW_SQLITE_IN_PRODUCTION=False

# ============================================================
# Email
# ============================================================
# Backend ایمیل. در dev از console-renderable استفاده می‌شود.
EMAIL_BACKEND=apps.core.email_backends.ReadableConsoleEmailBackend

# مهلت اتصال SMTP (ثانیه) — production مقداری realistic مثل 30.
EMAIL_TIMEOUT=30

# تنظیمات SMTP — پیشنهاد رایگان/transactional: Brevo SMTP.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

DEFAULT_FROM_EMAIL=noreply@setadjang.local

# ============================================================
# Authentication / OTP
# ============================================================
# Provider برای ارسال OTP.
# - email: ارسال از طریق Django email backend
# - sms  : ارسال از طریق SMS vendor (نیاز به تنظیم OTP_SMS_PROVIDER)
OTP_PROVIDER=email
OTP_EMAIL_PROVIDER=django_email

# SMS تا قبل از مجوز باید console/dev بماند. بعد از مجوز می‌توان http را فعال کرد.
OTP_SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
SMS_TIMEOUT_SECONDS=10

# ── OTP (مقادیر امنیتی — فاصلهٔ بین درخواست‌ها و عمر کد) ──
AUTH_OTP_CODE_LENGTH=6
AUTH_OTP_TTL_SECONDS=120
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5

# ── JWT ──
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# کلید امضای مستقل برای JWT (اختیاری).
# اگر تنظیم نشود، از SECRET_KEY استفاده می‌شود.
# در production توصیه می‌شود مجزا باشد:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
JWT_SIGNING_KEY=

# ── Anti-abuse: Global OTP guard ──
# حداکثر تعداد درخواست OTP در کل سیستم در یک بازه زمانی.
# اگر از این حد بگذرد، OTP issuance موقتاً متوقف می‌شود.
# پیش‌فرض development: 1000 در 60 ثانیه
# پیش‌فرض production : 500 در 60 ثانیه
AUTH_OTP_GLOBAL_THRESHOLD=1000
AUTH_OTP_GLOBAL_WINDOW_SECONDS=60

# ── Legacy API deprecation ──
# تاریخ sunset برای endpointهای auth v1 (منسوخ‌شده).
# در صورت تنظیم، در هر response از legacy endpoints به‌عنوان
# Sunset header ارسال می‌شود.
# فرمت: RFC 7231 مثل "Sun, 01 Jan 2027 00:00:00 GMT"
# اگر خالی باشد، Sunset header ارسال نمی‌شود.
AUTH_LEGACY_SUNSET=

# ============================================================
# Tabyin (Jihad Tabyin) — external source
# ============================================================
# Provider داده‌ی تبیین. مقادیر مجاز: mohtavanegar
TABYIN_PROVIDER=mohtavanegar

TABYIN_SOURCE_BASE_URL=https://app-service.armansky.ir

# Token احراز هویت برای منبع داده. این مقدار حساس است؛
# در production در secret manager نگه‌داری شود.
TABYIN_SOURCE_AUTH_TOKEN=replace-with-real-token

TABYIN_SOURCE_TIMEOUT=30
TABYIN_SOURCE_MAX_RETRIES=3

# ============================================================
# Cache
# ============================================================
# ── Cache invalidation (مکانیزم invalidate بعد از write) ──
CACHE_INVALIDATION_OUTBOX_ENABLED=True
CACHE_INVALIDATION_BATCH_SIZE=100
CACHE_INVALIDATION_MAX_ATTEMPTS=5
CACHE_INVALIDATION_RETRY_BASE_SECONDS=2
CACHE_INVALIDATION_RETRY_MAX_SECONDS=300

# Backend cache. مقادیر مجاز: locmem, redis
# - locmem: فقط برای development local؛ در production استفاده نشود.
# - redis : برای staging/production توصیه می‌شود.
CACHE_BACKEND=locmem

# آدرس Redis. هم برای cache و هم به‌صورت پیش‌فرض برای Celery استفاده می‌شود.
REDIS_URL=redis://127.0.0.1:6379/1

# ============================================================
# Media / Object Storage / CDN
# ============================================================
# local: فایل‌ها داخل MEDIA_ROOT ذخیره می‌شوند.
# s3   : S3/MinIO compatible storage برای production/CDN.
MEDIA_STORAGE_BACKEND=local

# Scanner سبک پیش‌فرض پسوندهای خطرناک را reject می‌کند.
# بعداً می‌توان ClamAV/vendor scanner را پشت همین contract جایگزین کرد.
# default = blocklist پسوند + بررسی امضای محتوا | extension_blocklist | noop
FILE_SCAN_PROVIDER=default

# S3/MinIO settings. برای MinIO، AWS_S3_ENDPOINT_URL را تنظیم کن.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# اگر CDN داری، دامنه CDN public media را اینجا بده.
# مثال: cdn.example.com
AWS_S3_CUSTOM_DOMAIN=

# ============================================================
# Celery
# ============================================================
# اگر تنظیم نشوند، به‌صورت خودکار از REDIS_URL استفاده می‌کنند.
# اگر تنظیم نشوند، هر دو از REDIS_URL مشتق می‌شوند؛ برای production صریح‌تر است.
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================================
# Observability / Monitoring
# ============================================================
# LOG_FORMAT=text برای dev خوانا؛ LOG_FORMAT=json برای production/log aggregator.
LOG_FORMAT=text

# ── DB performance telemetry (metrics و لاگ کوئری‌های کند) ──
DB_QUERY_TELEMETRY_ENABLED=True
DB_SLOW_QUERY_THRESHOLD_MS=200
DB_QUERY_COUNT_WARNING_THRESHOLD=50
DB_TOTAL_QUERY_TIME_WARNING_MS=5000
DEFAULT_PERFORMANCE_BUDGET_MS=300

# سقف رکورد خروجی exportهای admin (بازرسی/گزارش‌گیری).
EXPORT_MAX_ROWS=5000

# Prometheus metrics endpoint: /api/v1/metrics/
PROMETHEUS_METRICS_ENABLED=True

# Sentry اختیاری است؛ اگر DSN خالی باشد initialize نمی‌شود.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# OpenTelemetry tracer provider اختیاری و env-driven.
OTEL_ENABLED=False
OTEL_SERVICE_NAME=setad-jang-api

# ============================================================
# Security (فقط production)
# ============================================================
# HTTPS redirect — در production باید True باشد.
# در Docker با reverse proxy، معمولاً False می‌ماند (proxy handle می‌کند).
SECURE_SSL_REDIRECT=False

# HSTS — در production واقعی مقدار پیشنهادی 31536000 = یک سال است.
# در docker-compose local برای جلوگیری از اثر مرورگر روی localhost مقدار 0 override شده است.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# لیست originهای مجاز برای CORS، جداشده با کاما.
# در production باید دقیقاً دامنه‌های frontend را مشخص کنی.
# مثال: https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=
# ============================================================
# OpenAPI / Swagger
# ============================================================
# ── Frontend revalidation (اعلان به فرانت بعد از تغییر داده) ──
FRONTEND_REVALIDATION_ENABLED=False
FRONTEND_REVALIDATION_URL=
FRONTEND_REVALIDATION_SECRET=change-me-revalidation-secret
FRONTEND_REVALIDATION_TIMEOUT=5

# Public base URL shown by Swagger "Try it out".
# In production behind a domain, set this to the public origin, e.g. https://besat.me
OPENAPI_SERVER_URL=
# توضیح نمایشی backend در Swagger/OpenAPI.
OPENAPI_SERVER_DESCRIPTION=Setad Jang APIhttp://127.0.0.1:8000
OPENAPI_SERVER_DESCRIPTION=محیط توسعه (Local Development)

# ============================================================
# Audit logs / archival
# ============================================================
# ریشهٔ آرشیو فایل‌های audit (مسیر مطلق روی سرور/حجم).
AUDIT_LOG_ARCHIVE_ROOT=/var/lib/setadjang/audit-archive
# تعداد روزهای نگهداری لاگ‌های پردازش‌شده؛ صفر = حذف خودکار خاموش.
AUDIT_LOG_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DELETE_ENABLED=True
# سقف رکورد خروجی export دستی (audit logs).
AUDIT_LOG_EXPORT_MAX_RECORDS=10000
# توقف/ادامهٔ legal hold — وقتی فعال باشد، حذف رکوردها مسدود است.
AUDIT_LOG_LEGAL_HOLD_ENABLED=False

# ============================================================
# Notifications
# ============================================================
# پخش اعلان‌ها به‌صورت async (Celery) یا همزمان.
NOTIFICATIONS_ASYNC_DISPATCH=True
NOTIFICATIONS_EMAIL_ENABLED=True
NOTIFICATIONS_SMS_ENABLED=False

# ============================================================
# Kindness Wall — هوشمندی تطبیق
# ============================================================
# آستانهٔ تعداد تطبیق‌ها برای اعلان دسته‌ای (کنترل بار پیامک/ایمیل).
KINDNESS_MATCH_NOTIFICATION_THRESHOLD=10

# ============================================================
# Madadkar — پرداخت (Zarinpal)
# ============================================================
MADADKAR_PAYMENT_PROVIDER=zarinpal
MADADKAR_ZARINPAL_MERCHANT_ID=
MADADKAR_ZARINPAL_SANDBOX=True
MADADKAR_PAYMENT_CALLBACK_BASE_URL=https://setadjang.example.com
MADADKAR_PAYMENT_TIMEOUT_MINUTES=15

# ============================================================
# Madadkar — ریسک/فرود (آستانه‌های اسکورینگ)
# ============================================================
MADADKAR_RISK_HIGH_AMOUNT_NEW_USER_THRESHOLD=100000000
MADADKAR_RISK_IP_DISTINCT_USERS_THRESHOLD=5
MADADKAR_RISK_PAYMENT_FAILURE_SPIKE_THRESHOLD=0.5
MADADKAR_RISK_REFUND_VELOCITY_THRESHOLD=0.3
MADADKAR_RISK_ADJUSTMENT_RATIO_THRESHOLD=0.1
MADADKAR_RISK_CAMPAIGN_REFUND_SPIKE_THRESHOLD=0.4

# ============================================================
# Gunicorn (فقط در کانتینر اثر دارد)
# ============================================================
# worker class پیش‌فرض gthread است چون مسیر request این پروژه I/O مسدودکننده
# دارد (درگاه پرداخت، پنل پیامک). سقف اتصال دیتابیس این سرویس برابر
# GUNICORN_WORKERS × GUNICORN_THREADS است.
GUNICORN_WORKER_CLASS=gthread
GUNICORN_WORKERS=3
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# ============================================================
# Flower (داشبورد Celery)
# ============================================================
# اجباری است — سرویس flower بدون این دو مقدار بالا نمی‌آید.
# داشبورد فقط روی 127.0.0.1:5555 هاست publish می‌شود.
FLOWER_USER=change-me-flower-user
FLOWER_PASSWORD=change-me-flower-password

# ACL آپلودها: none (توصیه‌شده، سازگار با bucket owner enforced) | public-read | private
AWS_DEFAULT_ACL_MODE=none
