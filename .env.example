# ============================================================
# Setad Jang — Environment Variables Example
# ============================================================
# این فایل صرفاً یک reference است و نباید مقادیر واقعی production
# داخل آن قرار بگیرد. برای محیط local یک کپی به اسم `.env` بساز
# و مقادیر را آنجا تنظیم کن. خود `.env` در .gitignore است.
#
# قرارداد:
# - مقادیر داخل این فایل نمونه/توضیحی هستند، نه واقعی
# - برای production باید SECRET_KEY، ALLOWED_HOSTS و سایر مقادیر
#   حساس را در یک secret manager یا env واقعی سرور تنظیم کنی
#
# ── 12-Factor App ──
# هر تنظیم environment-specific باید فقط از طریق این متغیرها
# قابل تغییر باشد، نه از طریق ویرایش کد.

# ============================================================
# Django core
# ============================================================
# نام ماژول settings برای Django.
# - development: config.settings.development
# - production : config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# کلید محرمانه‌ی Django.
# در production هرگز از مقدار پیش‌فرض استفاده نکن.
# می‌توانی با این دستور یک کلید قوی بسازی (حداقل 50 کاراکتر):
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=change-me-in-production

# حالت دیباگ. در production حتماً False باشد.
DEBUG=True

# لیست hostهای مجاز، جداشده با کاما.
# در production باید دامنه‌های واقعی پروژه را بنویسی.
ALLOWED_HOSTS=127.0.0.1,localhost

# ============================================================
# Database
# ============================================================
# Development default در base.py همچنان SQLite است؛ production.py به‌صورت
# پیش‌فرض PostgreSQL می‌خواهد. برای production واقعی از PostgreSQL استفاده کن.
DATABASE_ENGINE=sqlite
DATABASE_PATH=

# PostgreSQL — برای config.settings.production و docker-compose.
# یک password قوی بساز و هرگز مقدار واقعی production را commit نکن.
POSTGRES_DB=setadjang
POSTGRES_USER=setadjang
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10

# فقط برای demo/emergency local؛ production واقعی نباید SQLite باشد.
ALLOW_SQLITE_IN_PRODUCTION=False

# ============================================================
# Email
# ============================================================
# Backend ایمیل. در dev از console-renderable استفاده می‌شود.
EMAIL_BACKEND=apps.core.email_backends.ReadableConsoleEmailBackend

# تنظیمات SMTP — فقط برای production لازم است.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

DEFAULT_FROM_EMAIL=noreply@setadjang.local

# ============================================================
# Authentication / OTP
# ============================================================
# Provider برای ارسال OTP.
# - email: ارسال از طریق Django email backend
# - sms  : ارسال از طریق SMS vendor (نیاز به تنظیم OTP_SMS_PROVIDER)
OTP_PROVIDER=email

# کلید امضای مستقل برای JWT (اختیاری).
# اگر تنظیم نشود، از SECRET_KEY استفاده می‌شود.
# در production توصیه می‌شود مجزا باشد:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
JWT_SIGNING_KEY=

# ── Anti-abuse: Global OTP guard ──
# حداکثر تعداد درخواست OTP در کل سیستم در یک بازه زمانی.
# اگر از این حد بگذرد، OTP issuance موقتاً متوقف می‌شود.
# پیش‌فرض development: 1000 در 60 ثانیه
# پیش‌فرض production : 500 در 60 ثانیه
AUTH_OTP_GLOBAL_THRESHOLD=1000
AUTH_OTP_GLOBAL_WINDOW_SECONDS=60

# ── Legacy API deprecation ──
# تاریخ sunset برای endpointهای auth v1 (منسوخ‌شده).
# در صورت تنظیم، در هر response از legacy endpoints به‌عنوان
# Sunset header ارسال می‌شود.
# فرمت: RFC 7231 مثل "Sun, 01 Jan 2027 00:00:00 GMT"
# اگر خالی باشد، Sunset header ارسال نمی‌شود.
AUTH_LEGACY_SUNSET=

# ============================================================
# Tabyin (Jihad Tabyin) — external source
# ============================================================
# Provider داده‌ی تبیین. مقادیر مجاز: mohtavanegar
TABYIN_PROVIDER=mohtavanegar

TABYIN_SOURCE_BASE_URL=https://app-service.armansky.ir

# Token احراز هویت برای منبع داده. این مقدار حساس است؛
# در production در secret manager نگه‌داری شود.
TABYIN_SOURCE_AUTH_TOKEN=replace-with-real-token

TABYIN_SOURCE_TIMEOUT=30
TABYIN_SOURCE_MAX_RETRIES=3

# ============================================================
# Cache
# ============================================================
# Backend cache. مقادیر مجاز: locmem, redis
# - locmem: فقط برای development local؛ در production استفاده نشود.
# - redis : برای staging/production توصیه می‌شود.
CACHE_BACKEND=locmem

# آدرس Redis. هم برای cache و هم به‌صورت پیش‌فرض برای Celery استفاده می‌شود.
REDIS_URL=redis://127.0.0.1:6379/1

# ============================================================
# Celery
# ============================================================
# اگر تنظیم نشوند، به‌صورت خودکار از REDIS_URL استفاده می‌کنند.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/2
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================================
# Security (فقط production)
# ============================================================
# HTTPS redirect — در production باید True باشد.
# در Docker با reverse proxy، معمولاً False می‌ماند (proxy handle می‌کند).
SECURE_SSL_REDIRECT=False

# HSTS — در production واقعی مقدار پیشنهادی 31536000 = یک سال است.
# در docker-compose local برای جلوگیری از اثر مرورگر روی localhost مقدار 0 override شده است.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# لیست originهای مجاز برای CORS، جداشده با کاما.
# در production باید دقیقاً دامنه‌های frontend را مشخص کنی.
# مثال: https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=